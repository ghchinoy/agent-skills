{
  "name": "agent-skills-site",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "node scripts/prepare-assets.mjs && astro build",
    "dev": "node scripts/prepare-assets.mjs && astro dev",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "npm run typecheck && node --test \"tests/*.test.mjs\"",
    "check:live": "node scripts/check-live-links.mjs",
    "check:blobs": "node scripts/check-blob-links.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.4",
    "sharp": "0.35.3",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "typescript": "5.9.3"
  }
}
