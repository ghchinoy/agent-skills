{
  // ───────────────────────────────────────────────────────────────────────────
  // SCOPE OF THE TYPE CHECK
  //
  // `npm run typecheck` (`astro check`) runs with `checkJs: true` under
  // `astro/tsconfigs/strict`, covering every production module in `src/`,
  // `scripts/`, and `astro.config.mjs`:
  //
  //   CHECKED      src/loaders/skills.ts
  //                src/loaders/advise.mjs
  //                src/loaders/enumerate.mjs
  //                src/loaders/frontmatter.mjs
  //                src/loaders/links.mjs
  //                src/loaders/markdown.mjs
  //                src/loaders/site-pages.mjs
  //                src/loaders/spec-source.mjs
  //                src/sidebar.mjs
  //                src/site.config.mjs
  //                src/content.config.ts
  //                src/components/*.astro
  //                scripts/check-blob-links.mjs
  //                scripts/check-live-links.mjs
  //                scripts/prepare-assets.mjs
  //                astro.config.mjs
  //
  //   EXCLUDED     tests/*.mjs (executed and verified directly by `node --test`)
  //                dist/       (build output)
  // ───────────────────────────────────────────────────────────────────────────
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "astro.config.mjs"],
  "exclude": ["dist"],
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true
  }
}
